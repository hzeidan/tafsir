{
"k": "atiya-qawiya-ala-ad",
"a": 6,
"t": "tafsir",
"x": "«عاتية»: قوية شديدة على عاد مع قوتهم وشدتهم (الجلالين)."
},
{
"k": "nafkha-fasl",
"a": 13,
"t": "tafsir",
"x": "«نفخة واحدة»: للفصل بين الخلائق، وهي الثانية (الجلالين)."
},
{
"k": "ya-tanbih",
"a": 25,
"t": "irab",
"x": "«يا» في «يا ليتني» للتنبيه، إذ لا منادى بعدها."
},
{
"k": "fa-la-tamna",
"a": 32,
"t": "irab",
"x": "«فاسلكوه»: أدخلوه في السلسلة بعد إدخاله النار، ولم تمنع الفاء من تعلق الفعل بالظرف المتقدم «في سلسلة»."
},
{
"k": "musaddiqin-jalalayn",
"a": 49,
"t": "tafsir",
"x": "«وإنا لنعلم أن منكم» أيها الناس «مكذبين» بالقرآن، ومصدّقين."
},
{
"k": "ba-zaida-jalalayn",
"a": 52,
"t": "irab",
"x": "قال الجلالان: الباء في «باسم ربك» زائدة، أي: نزّه ربك العظيم."
}
]